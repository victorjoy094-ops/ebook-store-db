{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "An ebook available for purchase or subscription reading.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "isbn13": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "previewUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "hasAudiobook": { "type": "boolean" },
        "audiobookRequestStatus": { "type": "string", "enum": ["none", "requested", "paid"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isFree": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "pending", "published"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "isbn13", "category", "price", "coverUrl", "pdfUrl"]
    },
    "AuthorApplication": {
      "title": "AuthorApplication",
      "description": "A request from a user to become a verified author.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "bio": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "A record of system or admin actions for accountability.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "performedBy", "timestamp"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A record of a book purchase by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "tx_ref": { "type": "string" }
      },
      "required": ["userId", "bookId", "amount", "timestamp"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "A record of a user's subscription tier.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tier": { "type": "string", "enum": ["monthly", "yearly"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "expired", "cancelled"] }
      },
      "required": ["userId", "tier", "startDate", "endDate", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "A book review and rating.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "bookId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookId", "rating"]
    },
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "subscriptionTier": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "isAuthor": { "type": "boolean" },
        "wishlist": { "type": "array", "items": { "type": "string" } },
        "followingAuthors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Collection": {
      "title": "Collection",
      "description": "A curated group of books (e.g., Staff Picks, Summer Reading).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "bookIds": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["staff_pick", "curated", "thematic"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "bookIds", "type", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A message sent from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "status", "createdAt"]
    },
    "Ad": {
      "title": "Ad",
      "description": "An advertisement space for scripts/code.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "position": { "type": "string", "enum": ["home_hero", "home_featured", "store_sidebar", "book_details_bottom"] },
        "code": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "position", "code", "active", "createdAt"]
    },
    "Journal": {
      "title": "Journal",
      "description": "A scholarly journal or article.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "abstract": { "type": "string" },
        "contentUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "readCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "authorId", "abstract", "contentUrl", "status", "createdAt"]
    },
    "JournalSubmission": {
      "title": "Journal Submission",
      "description": "A journal article submitted by an author for review.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "abstract": { "type": "string" },
        "fileUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "vetting", "accepted", "rejected", "published"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "authorName", "authorId", "abstract", "fileUrl", "status", "paymentStatus", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Public metadata and preview of a blog post.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "summary": { "type": "string", "description": "Preview text shown before paywall." },
        "coverUrl": { "type": "string" },
        "category": { "type": "string" },
        "readCount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "authorId", "authorName", "summary", "status", "createdAt"]
    },
    "StoryContent": {
      "title": "StoryContent",
      "description": "The actual full text of a blog post, restricted to subscribers.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content"]
    }
  },
  "firestore": {
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Blog post headers and summaries."
    },
    "/stories/{storyId}/content/full": {
      "schema": "StoryContent",
      "description": "Full text of the blog post (Secure)."
    },
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Store for ebooks."
    },
    "/journals/{journalId}": {
      "schema": "Journal",
      "description": "Published scholarly journals and articles."
    },
    "/journalSubmissions/{submissionId}": {
      "schema": "JournalSubmission",
      "description": "Submissions for journal publication."
    },
    "/applications/{appId}": {
      "schema": "AuthorApplication",
      "description": "Applications to become an author."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "System audit logs."
    },
    "/transactions/{transactionId}": {
      "schema": "Purchase",
      "description": "Records of individual book and subscription transactions."
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "User subscription records."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "User reviews for books."
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Curated collections of books."
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Messages from the contact form.",
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Advertisement slots and their corresponding code snippets."
    }
  }
}
